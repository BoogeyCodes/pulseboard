{
  "ConnectionStrings": {
    "Default": "Data Source=pulseboard.db"
  },
  "Jwt": {
    "Issuer": "pulseboard",
    "Audience": "pulseboard",
    "Key": "dev-only-key-change-me-in-production-0123456789",
    "LifetimeMinutes": 480
  },
  "Telemetry": {
    "SimulatorEnabled": true,
    "SampleIntervalSeconds": 2,
    "OfflineAfterSeconds": 15,
    "RetentionMinutes": 120
  },
  "Cors": {
    "Origins": ["http://localhost:5173"]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
